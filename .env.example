# MasterKey — environment variables (names only; never commit real values).
#
# Copy to .env.local and fill in. Each group is tagged:
#   [REQUIRED]    — the app won't work without it.
#   [RECOMMENDED] — works without it, but degrades to a limited mode (noted inline).
#   [OPTIONAL]    — has a safe default or no-ops when absent; skip for local dev.
# Step-by-step "where to get each value" lives in the getting-started skill: https://masterkey.sh/skill

# =========================== REQUIRED ===========================

# --- [REQUIRED] MongoDB — the one real database (users, oauth, ledger, jobs, runs, bundles) ---
MONGODB_URI=                    # mongodb+srv://… connection string (e.g. MongoDB Atlas free tier)
MONGODB_DB=masterkey            # database name (default: masterkey)

# --- [REQUIRED] CDP embedded wallet — user login / identity ONLY (email → OTP); not payments ---
NEXT_PUBLIC_CDP_PROJECT_ID=     # public, client SDK — from portal.cdp.coinbase.com
CDP_API_KEY_ID=                 # server, for endUser.validateAccessToken
CDP_API_KEY_SECRET=             # server

# --- Sign-in access control (optional) ---
# Restrict sign-in to one or more email domains (comma-separated; leading "@" optional),
# e.g. "@coinbase.com" or "coinbase.com,example.org". Leave BLANK to let ANY email sign in
# (the default for forks/self-hosters). Not a secret — it's shown in the sign-in dialog.
NEXT_PUBLIC_SIGNIN_ALLOWLIST=

# --- [REQUIRED] Master wallet = Sponge (@paysponge/sdk) — pays every x402 provider on the user's behalf ---
# Provide ONE of SPONGE_API_KEY or SPONGE_MASTER_KEY. Fund the wallet before paid calls (see /skill Step 6).
SPONGE_API_KEY=                 # sponge_live_… least-privilege agent key for ONE funded master wallet
SPONGE_MASTER_KEY=              # OR sponge_master_… — MasterKey auto-provisions/reuses the agent from it
# The SDK already points at Sponge's API by default.
SPONGE_API_URL=https://api.wallet.paysponge.com   # default shown; leave unset to use it

# --- [REQUIRED] Anthropic — the agent "brain" (durable web runs, Bundle Studio assist/generate) ---
ANTHROPIC_API_KEY=              # from console.anthropic.com (CLAUDE_ANTHROPIC_API_KEY is an accepted alias)

# --- [REQUIRED] OAuth 2.1 secrets — MasterKey is its own Authorization + Resource Server ---
OAUTH_JWT_SIGNING_KEY=          # signs access tokens / session cookies — generate: openssl rand -hex 32
SESSION_SECRET=                 # first-party mk_session cookie signing — generate: openssl rand -hex 32
OAUTH_ISSUER=http://localhost:3000   # public issuer URL (default localhost; prod = https://masterkey.sh)

# ========================= RECOMMENDED =========================

# --- [RECOMMENDED] Trigger.dev v4 — durable run runtime ---
# Without these, a Mongo-polling shim runs single-shot goals but has NO durable pause/approval waitpoints.
TRIGGER_PROJECT_REF=            # proj_… from cloud.trigger.dev
TRIGGER_SECRET_KEY=             # tr_dev_… locally / tr_prod_… in production

# =========================== OPTIONAL ===========================

# --- [OPTIONAL] Spend / pricing — all have working defaults ---
MASTERKEY_DEFAULT_PRICE_CEILING_USD=1.00   # fallback per-call cap for unknown-priced backends
SUPPORTED_NETWORKS=base                     # canonical network allowlist

# --- [OPTIONAL] URLs — default to localhost / the prod domain ---
# NEXT_PUBLIC_BASE_URL=http://localhost:3000   # site metadata base (default https://www.masterkey.sh)
# MASTERKEY_ORIGIN=http://localhost:3000       # origin the durable worker calls back into (default localhost:3000)

# --- [OPTIONAL] Vercel KV (Upstash Redis) — API rate limiting only (proxy.ts). Absent → limiter no-ops. ---
# Not a database; just sliding-window counters. Names match Vercel's masterkey_ injection.
masterkey_KV_REST_API_URL=          # proxy.ts reads this
masterkey_KV_REST_API_TOKEN=        # proxy.ts reads this
masterkey_KV_REST_API_READ_ONLY_TOKEN=
masterkey_KV_URL=
masterkey_REDIS_URL=                # mcp-handler SSE resumability (currently unwired)

# --- [OPTIONAL] Vercel Blob — file storage for generated media (image/video). Absent → media mirroring no-ops. ---
BLOB_READ_WRITE_TOKEN=          # vercel_blob_rw_… ; @vercel/blob reads this automatically
masterkey_STORE_ID=             # informational; Vercel Blob store id

# airv2 partner seam (server-to-server). Shared with the airv2 control plane only — never a box/browser.
# POST /api/partner/airv2/token mints a per-user MCP token; per-user Sponge agent wallets need SPONGE_MASTER_KEY.
AIRV2_PARTNER_SECRET=
# Set to 0 to keep paying from the platform master wallet even when SPONGE_MASTER_KEY is present.
# SPONGE_PER_USER_WALLETS=1
